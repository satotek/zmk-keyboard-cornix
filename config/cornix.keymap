#include "zmk-helpers/helper.h"
#include "includes/cornix54.h"

#define HM_TAPPING_TERM 200
#define LT_TAPPING_TERM 250

#define HM_PRIOR_IDLE 125
#define LT_PRIOR_IDLE 150

// A higher index wins. WIN only swaps the IME thumbs on Base, so it sits
// right above Base; any higher and its &lt bindings cover the NumPad thumbs.
#define BASE   0
#define WIN    1
#define LOWER  2
#define RAISE  3
#define ADJUST 4
#define NAVI   5
#define NUM    6

// https://github.com/urob/zmk-config/tree/main#timeless-homerow-mods

#define KEYS_L LT0 LT1 LT2 LT3 LT4 LT5 LM0 LM1 LM2 LM3 LM4 LM5 LB0 LB1 LB2 LB3 LB4 LB5  // left hand
#define KEYS_R RT0 RT1 RT2 RT3 RT4 RT5 RM0 RM1 RM2 RM3 RM4 RM5 RB0 RB1 RB2 RB3 RB4 RB5  // right hand
// LH2 is the Tab thumb, RH2 is Backspace. HRM has to include them or
// Shift/Ctrl/Cmd never apply to those keys.
#define KEYS_T LH2 LH1 LH0 RH0 RH1 RH2
#define ZMK_POINTING_DEFAULT_MOVE_VAL 800
#define ZMK_POINTING_DEFAULT_SCRL_VAL 15

#include <behaviors.dtsi>
#include <behaviors/rgbled_widget.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/modifiers.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    // Activate ADJUST layer by pressing raise and lower

    behaviors {
        bspc_del: backspace_delete {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            display-name = "Backspace / Delete";

            bindings = <&kp BACKSPACE>, <&kp DELETE>;
            mods = <(MOD_LSFT | MOD_RSFT)>;
        };

        hm_l: homerow_mods_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;

            flavor = "balanced";
            tapping-term-ms = <HM_TAPPING_TERM>;
            quick-tap-ms = <200>;                // repeat on tap-into-hold
            require-prior-idle-ms = <HM_PRIOR_IDLE>;
            hold-trigger-key-positions = <KEYS_R KEYS_T>;
            hold-trigger-on-release;
        };

        hm_r: homerow_mods_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;

            flavor = "balanced";
            tapping-term-ms = <HM_TAPPING_TERM>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <HM_PRIOR_IDLE>;
            hold-trigger-key-positions = <KEYS_L KEYS_T>;
            hold-trigger-on-release;
        };

        // Plain &mt is hold-preferred, so rolling Esc into the next key
        // (Esc→j in Vim) became Ctrl+J. No positional trigger here: this key
        // exists for same-hand Ctrl+C / Ctrl+Z, which hm_l cannot do.
        esc_ctl: escape_control {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;

            flavor = "balanced";
            tapping-term-ms = <HM_TAPPING_TERM>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <HM_PRIOR_IDLE>;
        };

        lt: layer_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&mo>, <&kp>;

            // balanced keeps a roll (thumb released before the next key) a tap,
            // yet a held thumb + quick key gets the layer without waiting out
            // the tapping term as tap-preferred did. Prior idle keeps Space
            // typed mid-word a tap.
            flavor = "balanced";
            tapping-term-ms = <LT_TAPPING_TERM>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <LT_PRIOR_IDLE>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        adjust_layer {
            if-layers = <RAISE LOWER>;
            then-layer = <ADJUST>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";

            // ------------------------------------------------------------------------------------------------------------
            // |  TAB  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U   |  I   |  O   |  P   |  -  |
            // | ESC/C | A/C | S/A | D/G  |  F   |  G   |                   |  H   |  J   | K/G  | L/A  | ;/C  |  '  |
            // | SK SFT|  Z  |  X  |  C   |  V   |  B   | CAPS WORD | | REPEAT |  N   |  M   |  ,   |  .   |  /   | \/SHIFT |
            //             | GUI | ALT | CTRL | TAB/NUM | EN/SYM | SPACE/NAV | | ENTER | KANA/FN | BSPC/DEL | CTRL | ALT | GUI |

            bindings = <
&kp TAB  &kp Q          &kp W         &kp E         &kp R                &kp T                      &kp Y      &kp U                &kp I            &kp O         &kp P             &kp MINUS
&esc_ctl LCTRL ESC  &hm_l LCTRL A  &hm_l LALT S  &hm_l LGUI D  &kp F                &kp G                      &kp H      &kp J                &hm_r RGUI K     &hm_r RALT L  &hm_r RCTRL SEMI  &kp SQT
&sk LSHIFT  &kp Z       &kp X         &kp C         &kp V                &kp B        &caps_word  &key_repeat  &kp N      &kp M                &kp COMMA        &kp DOT       &kp FSLH          &hm_r RSHFT BSLH
&kp LCTRL &kp LGUI      &kp LALT      &lt NUM TAB   &lt LOWER LANG2      &lt NAVI SPACE              &kp ENTER  &lt RAISE LANG1      &bspc_del         &kp RCTRL     &kp RALT          &kp RGUI
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        Windows_layer {
            display-name = "Windows";

            // Toggled from Adjust. 英数 / かな taps become 無変換 / 変換.
            // Holds still open Symbols / Function. Other keys fall through.

            bindings = <
&trans &trans &trans &trans &trans &trans                    &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans                    &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans &trans &trans      &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &lt LOWER INT_MUHENKAN &trans    &trans &lt RAISE INT_HENKAN &trans &trans &trans &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        Symbol_layer {
            display-name = "Symbols";

            // ------------------------------------------------------------------------------------------------------------
            // |   `   |  ~  |  !  |  @  |  #  |  $  |                   |  [  |  ]  |  {  |  }  |  (  |  )  |
            // |   %   |  ^  |  &  |  ;  |  '  |  "  |                   |  =  |  -  |  +  |  *  |  /  |  \  |
            // |       |     |     |     |     |     |        |  |       |  <  |  >  |  _  |  |  |  ?  |  :  |
            //               |     |     |     |     |        |  |       |     |     |     |     |

            bindings = <
&kp GRAVE  &kp TILDE  &kp EXCL   &kp AT    &kp HASH  &kp DLLR                  &kp LBKT   &kp RBKT  &kp LBRC   &kp RBRC  &kp LPAR      &kp RPAR
&kp PRCNT  &kp CARET  &kp AMPS   &kp SEMI  &kp SQT   &kp DQT                   &kp EQUAL  &kp MINUS &kp PLUS   &kp ASTRK &kp FSLH      &kp BSLH
&none      &none      &none      &none     &none     &none      &trans  &trans  &kp LT     &kp GT    &kp UNDER  &kp PIPE  &kp QUESTION  &kp COLON
&trans  &trans    &trans    &trans    &trans    &trans                     &trans     &trans        &trans     &trans     &trans    &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        Function_layer {
            display-name = "Function";

            // ------------------------------------------------------------------------------------------------------------
            // |  F1  |  F2  |  F3  |  F4  |  F5  |  F6  |                   |      |      |      |      |      |      |
            // |  F7  |  F8  |  F9  | F10  | F11  | F12  |                   | HOME | END  | PGUP | PGDN | INS  | PSCR |
            // |      |      |      |      |      |      |        |  |       |      |      |      |      |      |      |
            //               |      |      |      |      |       |  |       |      |      |      |      |

            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4   &kp F5  &kp F6                         &none     &none       &none        &none         &none    &none
&kp F7  &kp F8  &kp F9  &kp F10  &kp F11 &kp F12                        &kp HOME  &kp END     &kp PAGE_UP  &kp PAGE_DOWN &kp INS  &kp PSCRN
&trans  &none   &none   &none    &none   &none          &trans  &trans  &none     &none       &none        &none         &none    &trans
&trans  &trans  &trans  &trans   &trans  &trans                         &trans    &trans      &trans       &trans        &trans   &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        Adjust_layer {
            display-name = "Adjust";

            // ----------------------------------------------------------------------------------------------------------------------------
            // | BT CLR |  BT 0   |  BT 1   |  BT 2   |  BT 3   |  BT 4   |                  | OUT TOG | USB | BLE | STUDIO | BAT | CON |
            // | CLR ALL| DISC 0  | DISC 1  | DISC 2  | DISC 3  | DISC 4  |                  |  BASE   | WIN | CAPS| POWER  | NUM |     |
            // | PAUSE  | SCROLL  | MENU    | SYS RST | SOFT OFF| BOOT L  |        |  |      | BOOT R  |     |     |        |     |     |
            //                    |         |         |         |         |        |  |      |         |     |     |        |

            bindings = <
&bt BT_CLR      &bt BT_SEL 0   &bt BT_SEL 1   &bt BT_SEL 2   &bt BT_SEL 3   &bt BT_SEL 4                   &out OUT_TOG  &out OUT_USB  &out OUT_BLE  &studio_unlock     &ind_bat  &ind_con
&bt BT_CLR_ALL  &bt BT_DISC 0  &bt BT_DISC 1  &bt BT_DISC 2  &bt BT_DISC 3  &bt BT_DISC 4                  &to BASE      &tog WIN      &kp CAPSLOCK  &ext_power EP_TOG  &kp KP_NUMLOCK  &none
&kp PAUSE_BREAK &kp SCROLLLOCK &kp K_APP       &sys_reset      &soft_off       &bootloader     &trans  &trans  &bootloader  &none          &none         &none              &none  &none
&none           &none          &none          &trans         &trans         &trans                         &trans        &trans         &trans        &none              &none  &none
            >;
        };

        Navi_layer {
            display-name = "Navi";

            // ------------------------------------------------------------------------------------------------------------
            // |      | LCLK  | MCLK | RCLK | SCRL U| SCRL D|                   | INS  | HOME | PGDN | PGUP | END   | DEL  |
            // |      | LEFT  | DOWN | UP   | RIGHT |       |                   | LEFT | DOWN | UP   | RIGHT| CAPS  | BSPC |
            // |      |       | SCRL L|SCRL R|      |       |        |  |       |      |      |      |      |       |      |
            //                |      |      |      |       |      |  |       |      |      |      |      |

            bindings = <
&none  &mkp MB1        &mkp MB3        &mkp MB2         &msc SCRL_UP     &msc SCRL_DOWN                       &kp INS       &kp HOME  &kp PAGE_DOWN  &kp PAGE_UP  &kp END    &kp DELETE
&none  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP     &mmv MOVE_RIGHT  &none                                 &kp LEFT      &kp DOWN  &kp UP         &kp RIGHT    &kp CAPSLOCK  &kp BACKSPACE
&trans &none           &msc SCRL_LEFT  &msc SCRL_RIGHT  &none            &none          &trans  &trans         &none         &none     &none          &none         &none      &trans
&trans &trans     &trans    &trans    &trans      &trans                        &trans        &trans    &trans         &trans        &trans     &trans
            >;
        };

        KeyPad_layer {
            display-name = "NumPad";
            bindings = <
&none  &none  &none  &none  &none  &none                  &kp KP_N7        &kp KP_N8        &kp KP_N9        &kp KP_MINUS  &kp KP_MULTIPLY  &none
&none  &none  &none  &none  &none  &none                  &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_N6        &kp KP_PLUS   &kp KP_DIVIDE    &none
&trans &none  &none  &none  &none  &none  &trans  &trans  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_N3        &none         &none            &trans
&trans &trans &trans &none  &none  &trans                 &kp KP_N0        &kp KP_DOT       &kp KP_ENTER     &trans        &trans           &trans
            >;
        };
    };
};
